# Salin file ini jadi .env lalu isi sesuai environment kamu.

# Connection string PostgreSQL (lokal saat development, cloud/Supabase/Neon saat production)
DATABASE_URL="postgresql://user:password@localhost:5432/repo_jurnal_dosen"

# Secret untuk NextAuth — generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-random-string"

# Diisi kalau nanti pakai Vercel Blob untuk storage production
# BLOB_READ_WRITE_TOKEN=""
